# FarryOn edge Caddyfile — admin SPA + API/WS reverse proxy, with optional
# TLS termination.
#
# SITE_ADDRESS comes from the environment (set by the compose overlay):
#   standalone mode    SITE_ADDRESS=<domain>  → Caddy owns 80/443 and
#                      provisions Let's Encrypt certificates automatically
#   behind-proxy mode  SITE_ADDRESS=http://:80 → plain HTTP; an existing
#                      reverse proxy (e.g. Nginx Proxy Manager) terminates TLS
#
# ACME_EMAIL is only meaningful in standalone mode.

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# ---- backend paths (FastAPI on the internal network) -------------------
	# /ws/live is a long-lived WebSocket; Caddy proxies upgrades transparently
	# and applies no read timeout to streamed connections by default.
	#
	# `/` is the public marketing site and `/download*` the direct APK, both
	# served by the backend (backend/app/web/router.py) rather than from the
	# SPA bundle — the page ships with the app that knows which builds exist.
	# `path /` matches the root exactly, so every other URL still falls
	# through to the SPA handler below.
	# /verify-email and /reset-password are the auth-email landing pages —
	# backend-rendered (web/router.py), NOT part of the admin SPA.
	@backend path /api /api/* /ws/* /healthz /readyz /detect / /download /download/* /farry-icon.png /favicon.ico /verify-email /reset-password
	handle @backend {
		reverse_proxy backend:8000
	}

	# /metrics is intentionally NOT proxied — Prometheus scrapes the backend
	# over the internal docker network; the exposition endpoint stays private.

	# ---- admin SPA (everything else) ---------------------------------------
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
