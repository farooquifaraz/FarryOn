# =====================================================================
# FarryOn — production environment for the Hostinger VPS stack
#
#   cp deploy/hostinger/env.production.example .env    # at the repo root
#   nano .env                                          # fill in the blanks
#
# (With the GitHub Actions pipeline you don't copy this file by hand — you
# paste the filled-in contents into the FARRYON_ENV repository secret and CI
# writes it to the VPS on every deploy.)
#
# PARITY WITH YOUR LOCAL SETUP
# Every setting below has the SAME default the backend uses locally, so an
# unset value behaves identically in both places. The differences that bite
# are the ones you set locally and forget here: open your local
# backend/.env side by side and carry over every non-empty value —
# especially API keys, because a missing key doesn't error, it silently
# disables that feature in production. See docs/HOSTINGER_DEPLOYMENT.md §5b.
#
# Full per-variable reference: backend/.env.example
# =====================================================================

# ─── Edge / TLS (required) ───────────────────────────────────────────────
# The domain whose A record points at this VPS.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# How web traffic reaches FarryOn (docs/HOSTINGER_DEPLOYMENT.md §7b):
#   standalone    FarryOn's Caddy owns ports 80/443 and does Let's Encrypt
#                 itself. Use on a VPS where nothing else serves web traffic.
#   behind-proxy  Another proxy (e.g. Nginx Proxy Manager) already owns
#                 80/443. FarryOn serves plain HTTP on FARRYON_HTTP_PORT,
#                 bound to the docker0 gateway (not public); forward your
#                 domain to it in that proxy with WebSocket support ON.
PROXY_MODE=standalone
FARRYON_HTTP_PORT=8080

# ─── Database (required) ─────────────────────────────────────────────────
# Password for the in-stack Postgres 16. Generate one:  openssl rand -hex 24
# Use letters+digits only — the value goes into a URL, where @ : / # ? have
# special meaning and would corrupt the connection string.
POSTGRES_USER=farryon
POSTGRES_PASSWORD=
POSTGRES_DB=farryon
# DATABASE_URL is derived automatically from the values above. Only set it
# if you use an external/managed Postgres instead of the compose one:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/farryon

# ─── Security (required) ─────────────────────────────────────────────────
# Any non-default value ENABLES JWT auth on /ws/live. Generate:
#   openssl rand -hex 32          (letters+digits only, as above)
JWT_SECRET=

# Lock CORS to your real origins (comma-separated, no spaces).
ALLOWED_ORIGINS=https://app.example.com

# Secret for the OAuth CSRF-state cookie. Defaults to JWT_SECRET if unset.
SESSION_SECRET=

# Token lifetimes issued by /auth/*. The mobile app refreshes on its own, so
# raising ACCESS_TOKEN_EXPIRE_MINUTES is not the fix for surprise sign-outs.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── First admin account (bootstrap) ─────────────────────────────────────
# Used once by `python -m scripts.seed_admin` (deploy.sh runs it for you).
# Safe to leave set afterwards; blanking the password after the first
# successful seed is good practice.
FIRST_SUPER_ADMIN_EMAIL=
FIRST_SUPER_ADMIN_PASSWORD=

# ─── AI provider ─────────────────────────────────────────────────────────
# gemini | openai | grok | mock  (mock = free, offline, for smoke-testing)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
GROK_API_KEY=
GROK_REALTIME_MODEL=grok-realtime
# Providers the app may pick per session (hello.provider).
ALLOWED_PROVIDERS=gemini,openai,grok,mock

# ─── Live translation ────────────────────────────────────────────────────
# Speech-to-speech translation. Unset TRANSLATE_PROVIDER follows AI_PROVIDER's
# mock switch; set explicitly to gemini_translate | mock_translate.
# Reuses GEMINI_API_KEY — no separate key needed.
TRANSLATE_PROVIDER=
GEMINI_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# Comma-separated target languages the UI may request (default covers 100+;
# leave unset unless you want to restrict it).
TRANSLATE_ALLOWED_TARGET_LANGS=
TRANSLATE_MAX_SESSION_SECONDS=3600

# ─── Vision: landmark & product finder ───────────────────────────────────
# Google Cloud Vision API key (LANDMARK_DETECTION + WEB_DETECTION). Powers
# the `identify_image` tool and POST /detect. The AI explanation reuses
# GEMINI_API_KEY.
VISION_API_KEY=

# Live camera-frame gate — the #1 realtime cost driver.
#   continuous | on_turn | off   (see backend/.env.example for the tradeoffs)
VISION_FRAME_MODE=on_turn
VISION_FRAME_MIN_INTERVAL_S=2.0
VISION_FRAME_HEARTBEAT_S=6.0
VISION_ON_DEMAND_ONLY=true

# ─── Messaging tools (send_message) ──────────────────────────────────────
# Leave unset to disable a channel. Telegram needs either a bot token or the
# api_id/api_hash/session triple; WhatsApp needs a Cloud API token + phone id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Dialling code assumed for local numbers without a country prefix.
DEFAULT_COUNTRY_CODE=971

# ─── web_search tool ─────────────────────────────────────────────────────
# mock | tavily | serper | serpapi. `mock` returns deterministic offline
# results — no network call. Chain two free tiers via the fallback pair.
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=
WEB_SEARCH_FALLBACK_PROVIDER=
WEB_SEARCH_FALLBACK_API_KEY=

# ─── SSO (Google / Microsoft) ────────────────────────────────────────────
# Leave unset to disable — /auth/sso/* returns 503 until a provider's
# id+secret pair is set. Walkthrough: docs/GOOGLE_SIGN_IN_SETUP.md
# GOOGLE_CLIENT_ID must be the *Web* client id (the phone's native sign-in
# passes it as serverClientId, so the ID token audience matches).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Must match a redirect URI registered with the provider (no trailing slash).
SSO_REDIRECT_BASE_URL=https://app.example.com
# If set, the OAuth callback redirects here with ?access_token=&refresh_token=
# instead of returning JSON.
SSO_FRONTEND_SUCCESS_URL=

# ─── Billing ─────────────────────────────────────────────────────────────
# Shared secret for the generic webhook (X-Webhook-Secret header); the
# endpoint returns 503 until it is set.
BILLING_WEBHOOK_SECRET=
# Stripe checkout — leave unset to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plan -> price id, e.g. {"pro":"price_123","team":"price_456"}
STRIPE_PRICE_IDS=
STRIPE_SUCCESS_URL=https://app.example.com/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://app.example.com/billing/cancel

# ─── Cost control & quotas ───────────────────────────────────────────────
# Sliding-window context compression (Live re-bills the whole history).
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_TRIGGER_TOKENS=16000
CONTEXT_TARGET_TOKENS=8000
# Bound runaway/idle sessions; the app reconnects fresh. 0 disables a cap.
MAX_SESSION_SECONDS=1800
IDLE_DISCONNECT_SECONDS=300
# Per-user daily quotas. Turn on for launch (needs real per-user auth).
QUOTA_ENFORCEMENT_ENABLED=false
DEFAULT_PLAN=free
# PLAN_CATALOG / PLAN_LIMITS are JSON overrides; the built-in catalog is the
# source of truth and derives the daily caps, so leave them unset normally.

# ─── Runtime tuning ──────────────────────────────────────────────────────
# uvicorn worker processes; ≈ number of vCPUs on the VPS (KVM2 → 2).
UVICORN_WORKERS=2
LOG_LEVEL=INFO
TOOL_TIMEOUT_SECONDS=20
TOOL_RESULT_MAX_CHARS=2000
# Max seconds a vision tool waits for a fresh frame (glasses need longer —
# BLE thumbnail transfer contends with the A2DP audio link).
FRAME_WAIT_SECONDS=8.0
GLASSES_FRAME_WAIT_SECONDS=18.0
FRAME_INGEST_SECONDS=1.2

# ─── Observability profile (only if using --profile obs) ─────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=
