# =====================================================================
# FarryOn — production environment for the Hostinger VPS stack
#
#   cp deploy/hostinger/env.production.example .env    # at the repo root
#   nano .env                                          # fill in the blanks
#
# This file is read by docker-compose.prod.yml (backend env_file + compose
# variable interpolation). Never commit the filled-in copy.
# Full variable reference: backend/.env.example and docs/DEPLOYMENT.md §5.
# =====================================================================

# ─── Edge / TLS (required) ───────────────────────────────────────────────
# The domain whose A record points at this VPS.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# How web traffic reaches FarryOn (docs/HOSTINGER_DEPLOYMENT.md §"Shared VPS"):
#   standalone    FarryOn's Caddy owns ports 80/443 and does Let's Encrypt
#                 itself. Use on a VPS where nothing else serves web traffic.
#   behind-proxy  Another proxy (e.g. Nginx Proxy Manager) already owns
#                 80/443. FarryOn serves plain HTTP on FARRYON_HTTP_PORT,
#                 bound to the docker0 gateway (not public); forward your
#                 domain to it in that proxy with WebSocket support ON.
PROXY_MODE=standalone
FARRYON_HTTP_PORT=8080

# ─── Database (required) ─────────────────────────────────────────────────
# Password for the in-stack Postgres 16. Generate one:  openssl rand -hex 24
POSTGRES_USER=farryon
POSTGRES_PASSWORD=
POSTGRES_DB=farryon
# DATABASE_URL is derived automatically from the values above. Only set it
# if you use an external/managed Postgres instead of the compose one:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/farryon

# ─── Security (required) ─────────────────────────────────────────────────
# Any non-default value ENABLES JWT auth on /ws/live. Generate:
#   openssl rand -hex 32
JWT_SECRET=

# Lock CORS to your real origins (comma-separated, no spaces).
ALLOWED_ORIGINS=https://app.example.com

# ─── First admin account (bootstrap) ─────────────────────────────────────
# Used once by `python -m scripts.seed_admin` (deploy.sh runs it for you).
# Safe to leave set afterwards, but best practice is to blank the password
# here after the first successful seed.
FIRST_SUPER_ADMIN_EMAIL=
FIRST_SUPER_ADMIN_PASSWORD=

# ─── AI provider ─────────────────────────────────────────────────────────
# gemini | openai | grok | mock  (mock = free, offline, for smoke-testing)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
GROK_API_KEY=
ALLOWED_PROVIDERS=gemini,openai,grok,mock

# ─── Optional integrations ───────────────────────────────────────────────
# Google Cloud Vision key for the landmark/product Finder (POST /detect).
VISION_API_KEY=
# Web search tool: mock | tavily | serper | serpapi (+ free-tier fallback).
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=
WEB_SEARCH_FALLBACK_PROVIDER=
WEB_SEARCH_FALLBACK_API_KEY=
# SSO — see docs/GOOGLE_SIGN_IN_SETUP.md. Leave unset to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Must match the OAuth redirect URI registered with the provider.
SSO_REDIRECT_BASE_URL=https://app.example.com
BILLING_WEBHOOK_SECRET=

# ─── Runtime tuning ──────────────────────────────────────────────────────
# uvicorn worker processes; ≈ number of vCPUs on the VPS (KVM2 → 2).
UVICORN_WORKERS=2
LOG_LEVEL=INFO
# Cost controls (sensible defaults; see backend/.env.example for details).
VISION_FRAME_MODE=on_turn
CONTEXT_COMPRESSION_ENABLED=true
MAX_SESSION_SECONDS=1800
IDLE_DISCONNECT_SECONDS=300
QUOTA_ENFORCEMENT_ENABLED=false

# ─── Observability profile (only if using --profile obs) ─────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=
